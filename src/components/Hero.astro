---
import { SITE } from '../data/site';
---

<section class="hero" id="top">
  <div class="hero-noise" aria-hidden="true"></div>
  <div class="wrap hero-inner">
    <p class="eyebrow eyebrow-light" data-reveal>
      Managed Websites &nbsp;&middot;&nbsp; {SITE.location}
    </p>
    <h1 data-reveal>
      <span class="h1-line">Your business handles business.</span>
      <span class="h1-line h1-accent">We handle your website.</span>
    </h1>
    <p class="hero-sub" data-reveal>
      Professional managed websites for roofers, contractors, HVAC, plumbing, electrical, and other
      local service businesses. We build it, host it, and maintain it &mdash; for one flat monthly
      price.
    </p>
    <div class="hero-actions" data-reveal>
      <a href="#start" class="btn btn-primary btn-large">Start My Website</a>
      <a href="#included" class="btn btn-ghost btn-large">See What's Included</a>
    </div>
    <p class="hero-meta" data-reveal>
      {SITE.priceDisplay}/month &nbsp;&middot;&nbsp; Fully managed &nbsp;&middot;&nbsp; Local
      support
    </p>
  </div>

  <div class="hero-visual" id="hero-visual" data-reveal aria-hidden="true">
    <div class="hero-visual-glow"></div>
    <div class="mockup-window">
      <div class="mockup-chrome">
        <span class="mockup-dot dot-a"></span>
        <span class="mockup-dot dot-b"></span>
        <span class="mockup-dot dot-c"></span>
        <div class="mockup-address"><span class="mockup-lock"></span>yourbusiness.com</div>
      </div>
      <div class="mockup-body">
        <div class="mockup-nav">
          <span class="mockup-logo"></span>
          <span class="mockup-navlink"></span>
          <span class="mockup-navlink"></span>
          <span class="mockup-navlink"></span>
          <span class="mockup-navbtn"></span>
        </div>
        <div class="mockup-hero">
          <span class="mockup-line mockup-line-lg"></span>
          <span class="mockup-line mockup-line-lg mockup-line-70"></span>
          <span class="mockup-line mockup-line-sm"></span>
          <span class="mockup-cta"></span>
        </div>
        <div class="mockup-tiles">
          <div class="mockup-tile">
            <span class="tile-dot"></span><span class="mockup-line mockup-line-xs"></span>
          </div>
          <div class="mockup-tile">
            <span class="tile-dot"></span><span class="mockup-line mockup-line-xs"></span>
          </div>
          <div class="mockup-tile">
            <span class="tile-dot"></span><span class="mockup-line mockup-line-xs"></span>
          </div>
        </div>
      </div>
    </div>
    <div class="mockup-phone">
      <div class="phone-notch"></div>
      <div class="phone-body">
        <span class="mockup-line mockup-line-sm"></span>
        <span class="mockup-line mockup-line-sm phone-line-60"></span>
        <span class="mockup-cta mockup-cta-sm"></span>
        <div class="phone-tiles">
          <span></span><span></span>
        </div>
      </div>
    </div>
  </div>
</section>
