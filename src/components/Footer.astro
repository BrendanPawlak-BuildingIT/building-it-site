---
import { FOOTER_NAV_LINKS, LEGAL_LINKS, SITE } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-top">
    <div class="footer-brand">
      <a href="/#top" class="logo">
        <img class="logo-mark" src="/brand-icon.png" alt="" width="28" height="28" />
        <span class="logo-text">Building<span>IT</span></span>
      </a>
      <p>{SITE.tagline}</p>
    </div>

    <div class="footer-col">
      <h4>Quick Links</h4>
      <ul>
        {
          FOOTER_NAV_LINKS.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="footer-col">
      <h4>Contact</h4>
      <ul>
        <li>
          <a href={SITE.phoneHref}>{SITE.phoneDisplay}</a>
        </li>
        <li>
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </li>
        <li>{SITE.location} &middot; {SITE.serviceArea}</li>
        <li>{SITE.hours}</li>
      </ul>
    </div>
  </div>

  <div class="wrap footer-bottom">
    <p>&copy; {year} {SITE.name}. All rights reserved.</p>
    <nav class="footer-legal" aria-label="Legal">
      {
        LEGAL_LINKS.map((link, i) => (
          <>
            <a href={link.href}>{link.label}</a>
            {i < LEGAL_LINKS.length - 1 && <span aria-hidden="true">&middot;</span>}
          </>
        ))
      }
    </nav>
  </div>
</footer>
