---
import { SITE } from '../data/site';
---

<section class="section final-cta">
  <div class="hero-noise" aria-hidden="true"></div>
  <div class="wrap final-cta-inner">
    <p class="cta-tag" data-reveal>{SITE.priceDisplay}/month</p>
    <h2 class="display-md" data-reveal>Stop managing<br /><em>your website.</em></h2>
    <p class="lead lead-light" data-reveal>
      You have a business to run. Let Building IT handle the website.
    </p>
    <a href="#start" class="btn btn-primary btn-large" data-reveal>Start My Website</a>
  </div>
</section>
