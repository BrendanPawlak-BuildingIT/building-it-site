---
import { PREPAY_DISCOUNT_PERCENT, PREPAY_MONTHS, PRICE_FEATURES, SITE } from '../data/site';
---

<section class="section pricing" id="pricing">
  <div class="wrap pricing-inner">
    <p class="eyebrow eyebrow-light" data-reveal>Pricing</p>
    <h2 class="display-sm dark-heading" data-reveal>
      We build your website.<br />Then we host and manage it.
    </h2>

    <p class="price-scope" data-reveal>Hosting &amp; Management</p>
    <div class="price-display" data-reveal>
      <span class="price-currency">$</span><span class="price-figure">{SITE.price}</span><span
        class="price-suffix">/month</span
      >
    </div>

    <ul class="price-list" data-reveal>
      {PRICE_FEATURES.map((feature) => <li>{feature}</li>)}
    </ul>

    <a href="#start" class="btn btn-primary btn-large" data-reveal>Start My Website</a>

    <p class="price-build-note" data-reveal>
      Need a new website or a rebuild? That's priced separately. {PREPAY_MONTHS} months upfront is {
        PREPAY_DISCOUNT_PERCENT
      }% off your website project.
    </p>
  </div>
</section>
